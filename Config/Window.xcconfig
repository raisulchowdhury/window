// Shared build settings for Window. Xcodegen applies this file to Debug and Release.
//
// Out of the box Window builds without an Apple developer account: the app is
// signed to run locally and the widget falls back to "Open Window".
// To sign with your own team (needed for the widget's shared data), copy
// Config/Local.xcconfig.example to Config/Local.xcconfig and set your team ID.
// Local.xcconfig is ignored by git.

// Bundle identifiers are WINDOW_BUNDLE_PREFIX plus a suffix, for example
// $(WINDOW_BUNDLE_PREFIX).app for the app and .app.widget for the widget.
// Set your own prefix in Config/Local.xcconfig. com.example.window is the example
// default for building from source with your own team.
WINDOW_BUNDLE_PREFIX = com.example.window

// The prefix of the official download on the website, read only by
// scripts/package-download.sh. Xcode builds ignore it.
WINDOW_RELEASE_BUNDLE_PREFIX = xyz.raisul.window
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

// Maintainer identity for this repository's own builds. Not part of the public release.
#include? "Maintainer.xcconfig"
#include? "Local.xcconfig"
